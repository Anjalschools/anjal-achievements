exports[`visual regression snapshots (deterministic HTML) > snapshots normalized portrait table shell 1`] = `"<!doctype html> <html lang="ar" dir="rtl"> <head> <meta charset="utf-8" /> <title>جدول</title> <style> @page { size: A4 portrait; } @page { size: A4 landscape; margin: 14mm 10mm 22mm 10mm; } @page { size: A4 portrait; margin: 14mm 10mm 22mm 10mm; } @page { @bottom-center { content: counter(page) " / " counter(pages); font-family: "Cairo", "Tajawal", Tahoma, "Segoe UI", Arial, sans-serif; font-size: 8pt; color: #94a3b8; font-variant-numeric: tabular-nums; } } * { box-sizing: border-box; } html, body { margin: 0; padding: 0; color: #0f172a; font-family: "Cairo", "Tajawal", Tahoma, "Segoe UI", Arial, sans-serif; font-size: 11px; line-height: 1.45; -webkit-print-color-adjust: exact; print-color-adjust: exact; } body { background: #fff; } .page-shell { position: relative; min-height: 100%; padding: 0 2mm; break-after: page; page-break-after: always; } .page-shell:last-child { break-after: auto; page-break-after: auto; } .page-content { position: relative; z-index: 1; } .page-section { margin-bottom: 6mm; break-inside: avoid; page-break-inside: avoid; } .page-section--flow { break-inside: auto; page-break-inside: auto; } .ep-h1 { margin: 0 0 8px; font-size: 28px; font-weight: 700; line-height: 1.2; text-align: center; color: #172554; } .ep-h2 { margin: 0 0 6px; font-size: 20px; font-weight: 600; color: #1E3A8A; break-after: avoid; } .ep-meta { margin: 0 0 10px; font-size: 12px; color: #64748b; text-align: center; } .ep-subtitle { margin: 0 0 6px; font-size: 12px; color: #64748b; text-align: center; font-weight: 600; } .ep-kicker { margin: 0 0 6px; font-size: 9px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; color: #64748b; text-align: center; } .ep-note { margin: 0 0 4mm; padding: 3mm 4mm; border: 1px solid #fde68a; background: #fffbeb; border-radius: 4px; font-size: 9px; color: #92400e; break-inside: avoid; } .ep-wm { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 56px; font-weight: 900; color: #94a3b8; opacity: 0.06; transform: rotate(-28deg); pointer-events: none; z-index: 0; } .ep-num { font-variant-numeric: tabular-nums; white-space: nowrap; } .ep-kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin: 8px 0 12px; break-inside: avoid; } .ep-kpi { border: 1px solid #CBD5E1; border-radius: 8px; padding: 8px 10px; background: #F8FAFC; break-inside: avoid; } .ep-kpi-label { font-size: 9px; color: #64748b; font-weight: 700; } .ep-kpi-value { font-size: 15px; font-weight: 800; margin-top: 4px; color: #172554; } .ep-meta-block { margin: 8px 0 10px; break-inside: avoid; border: 1px solid #CBD5E1; border-radius: 8px; padding: 8px; background: #fff; } table.ep-meta-grid { width: 100%; font-size: 9px; border-collapse: collapse; } table.ep-meta-grid th, table.ep-meta-grid td { border: 1px solid #CBD5E1; padding: 4px 6px; vertical-align: top; } table.ep-meta-grid th { width: 28%; background: #F8FAFC; color: #64748b; font-weight: 700; } .ep-charts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px; } .ep-block { border: 1px solid #CBD5E1; border-radius: 10px; padding: 10px; background: #fff; break-inside: avoid; } .ep-block h3 { margin: 0 0 6px; font-size: 13px; font-weight: 800; color: #172554; } @media print { html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; } body { margin: 0; } } .ep-official-header { margin: 0 0 4mm; break-inside: avoid; page-break-inside: avoid; } .ep-official-header--continuation { margin-bottom: 6mm; } .ep-official-header--compact .ep-official-meta { margin-top: 2mm; } .ep-official-header--compact .ep-title-main { font-size: 20px; } .ep-official-banner { display: block; width: 100%; margin: 0; padding: 0; line-height: 0; } .ep-official-banner img { width: 100%; max-height: 28mm; height: auto; object-fit: contain; object-position: top center; display: block; margin: 0 auto; -webkit-print-color-adjust: exact; print-color-adjust: exact; } .ep-official-meta { margin-top: 3mm; text-align: center; } .ep-official-meta .ep-title-main { margin: 0 0 4px; font-size: 28px; font-weight: 700; line-height: 1.15; color: #172554; } .ep-official-meta .ep-subtitle { margin: 0 0 4px; } .ep-official-meta .ep-meta-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 3mm 7mm; margin: 4px 0 0; padding: 0; list-style: none; font-size: 12px; color: #64748b; } .ep-official-meta .ep-meta-row li { margin: 0; } .ep-official-meta .ep-meta-row strong { font-weight: 800; color: #0f172a; } .ep-official-header + .page-section, .ep-official-header + .ep-note, .ep-official-header + .ep-table-wrap, .ep-official-header + .exec-panel { margin-top: 0; } /* Legacy class alias — routes to official header layout */ .ep-header { margin: 0 0 4mm; break-inside: avoid; page-break-inside: avoid; } .ep-title-main { margin: 6px 0 0; font-size: 28px; font-weight: 700; line-height: 1.15; color: #172554; } .ep-meta-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 3mm 7mm; margin: 6px 0 0; padding: 0; list-style: none; font-size: 12px; color: #64748b; } .ep-meta-row li { margin: 0; } .ep-meta-row strong { font-weight: 800; color: #0f172a; } .ep-footer { margin-top: 4mm; padding-top: 3mm; border-top: 1px solid #CBD5E1; font-size: 9px; color: #94a3b8; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 4mm; break-inside: avoid; } .ep-footer-brand { font-weight: 800; color: #64748b; } .ep-footer-dept { text-align: center; font-weight: 600; } .ep-footer-meta { text-align: end; font-variant-numeric: tabular-nums; } .ep-page-foot { display: flex; justify-content: space-between; align-items: center; gap: 4mm; margin-top: 6mm; padding-top: 2mm; border-top: 1px solid #CBD5E1; font-size: 9px; color: #64748b; } .ep-page-foot .ep-conf { font-weight: 700; color: #0f172a; } .ep-table-wrap { width: 100%; overflow: visible; margin-top: 4mm; text-align: center; } table.ep-grid { border-collapse: collapse; table-layout: fixed; width: 100%; max-width: 100%; margin-inline: auto; font-size: 11px; line-height: 1.35; direction: inherit; } table.ep-grid thead { display: table-header-group; } table.ep-grid tbody { display: table-row-group; } table.ep-grid th { background: #172554; color: #f8fafc; font-weight: 800; padding: 2.2mm 1.8mm; border: 1px solid #172554; text-align: right; vertical-align: middle; white-space: normal; } table.ep-grid td { border: 1px solid #CBD5E1; padding: 1.6mm 1.8mm; text-align: right; vertical-align: middle; word-break: break-word; overflow-wrap: break-word; } table.ep-grid tbody tr.ep-row-alt td { background: #F8FAFC; } table.ep-grid tr { break-inside: avoid; page-break-inside: avoid; } .ep-cell-name { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; max-height: 2.75em; line-height: 1.35; font-weight: 600; } .ep-cell-num { font-variant-numeric: tabular-nums; white-space: nowrap; text-align: end; } table.ep-grid th.ep-cell-num { text-align: end; } table.ep-mini { width: 100%; border-collapse: collapse; font-size: 10px; table-layout: fixed; } table.ep-mini th, table.ep-mini td { border: 1px solid #CBD5E1; padding: 5px 7px; text-align: right; vertical-align: middle; } table.ep-mini th { background: #E2E8F0; font-weight: 800; } table.ep-mini tbody tr:nth-child(even) td { background: #F8FAFC; } @media print { body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } table.ep-grid, table.ep-mini, table.ep-meta-grid { border-collapse: collapse; } table.ep-grid th, table.ep-grid td, table.ep-mini th, table.ep-mini td { -webkit-print-color-adjust: exact; print-color-adjust: exact; border-width: 1px; border-style: solid; } .ep-num, table.ep-grid td.ep-cell-num { font-variant-numeric: tabular-nums; font-feature-settings: "tnum" 1; } } .ep-continuation { font-size: 9px; color: #64748b; font-style: italic; margin: 0 0 4mm; break-after: avoid; } .ep-sr-caption { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; } h1, h2, h3, .ep-h1, .ep-h2 { break-after: avoid; page-break-after: avoid; } table.ep-grid caption.ep-sr-caption + thead { display: table-header-group; } @media print { body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } .ep-grid th { color: #f8fafc !important; background: #172554 !important; } .ep-grid td, .ep-grid th { border-color: #374151 !important; } } @media print and (monochrome) { .ep-grid th { background: #374151 !important; color: #fff !important; } .ep-kpi, .exec-panel { border-color: #6b7280 !important; background: #f9fafb !important; } } .ep-table-wrap { width: 100%; overflow: visible; margin-top: 4mm; text-align: center; } table.ep-grid { border-collapse: collapse; table-layout: fixed; width: 100%; max-width: 100%; margin-inline: auto; font-size: 11px; line-height: 1.35; direction: inherit; } table.ep-grid thead { display: table-header-group; } table.ep-grid tbody { display: table-row-group; } table.ep-grid th { background: #172554; color: #f8fafc; font-weight: 800; padding: 2.2mm 1.8mm; border: 1px solid #172554; text-align: right; vertical-align: middle; white-space: normal; } table.ep-grid td { border: 1px solid #CBD5E1; padding: 1.6mm 1.8mm; text-align: right; vertical-align: middle; word-break: break-word; overflow-wrap: break-word; } table.ep-grid tbody tr.ep-row-alt td { background: #F8FAFC; } table.ep-grid tr { break-inside: avoid; page-break-inside: avoid; } .ep-cell-name { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; max-height: 2.75em; line-height: 1.35; font-weight: 600; } .ep-cell-num { font-variant-numeric: tabular-nums; white-space: nowrap; text-align: end; } table.ep-grid th.ep-cell-num { text-align: end; } table.ep-mini { width: 100%; border-collapse: collapse; font-size: 10px; table-layout: fixed; } table.ep-mini th, table.ep-mini td { border: 1px solid #CBD5E1; padding: 5px 7px; text-align: right; vertical-align: middle; } table.ep-mini th { background: #E2E8F0; font-weight: 800; } table.ep-mini tbody tr:nth-child(even) td { background: #F8FAFC; } .exec-panel { border: 1px solid var(--ep-border, #CBD5E1); background: #F8FAFC; border-radius: 10px; padding: 12px 14px; margin-bottom: 14px; page-break-inside: avoid; } .ep-summary-list { margin: 8px 20px 0 0; padding: 0; font-size: 12px; line-height: 1.5; color: #334155; } </style> </head> <body> <div class="page-shell page-content"> <header class="ep-official-header" data-official-report-header="1"> <div class="ep-official-banner"><img src="/report-header.png" alt="" /></div> <div class="ep-official-meta"> <h1 class="ep-title-main" dir="auto">تقرير تنفيذي — جدول</h1> <ul class="ep-meta-row"><li><strong>نوع التقرير:</strong> جدول</li><li><strong>تاريخ التصدير:</strong> __DATE__</li></ul> </div> </header> <div class="ep-table-wrap"><table class="ep-grid" style="width:16mm" dir="rtl" role="table"> <colgroup><col style="width:16mm" /></colgroup> <thead><tr><th scope="col" class="ep-cell" style="text-align:right">البند</th></tr></thead> <tbody><tr class="ep-row"><td class="ep-cell">قيمة</td></tr></tbody> </table></div> <footer class="ep-footer"> <span class="ep-footer-brand">منصة تميز الأنجال</span> <span class="ep-footer-dept">قسم الحاسب بمدارس الأنجال الأهلية</span> <span class="ep-footer-meta">جدول · __DATE__</span> </footer> <p class="ep-page-foot" aria-hidden="true"> <span class="ep-conf">للاستخدام الداخلي — مدارس الأنجال</span> </p> </div> </body> </html>"`;
