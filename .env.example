# Upstash Redis (optional) — shared rate limiting for login/register/contact (5 req / 60s per route+IP).
# If omitted, falls back to in-memory rate limit (single Node process only).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# MongoDB, auth, etc. — copy to `.env.local` and fill in real values.
# Prefer Atlas `mongodb+srv://...` URIs in production for reliable DNS/TLS.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/

# Public site URL (no trailing slash) — used for certificate QR codes and server-rendered verify links.
# Example: https://anjal-achievements.com
# Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# OpenAI — required for AI assist, certificate attachment review, and letter generation
# (no key ⇒ isAiAssistEnabled() is false system-wide).
OPENAI_API_KEY=
# Optional; default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Explicit off: false | 0 | off | no | disabled. Unset ⇒ enabled only if OPENAI_API_KEY is set.
# AI_ASSIST_ENABLED=true

# Logs hasOpenAiKey / aiAssistEnabled per route (never logs the key)
# AI_DEBUG=1

# ── Render production (official scheduler for Competition Intelligence Lifecycle) ──
# Set in Render Dashboard → Environment (Web Service + Cron Jobs share the same env group).
CRON_SECRET=
# Public app URL for manual cron scripts (npm run cron:*). On Render Web Service, RENDER_EXTERNAL_URL is set automatically.
# APP_URL=https://your-render-domain.onrender.com

# Render Cron Jobs (Dashboard → New → Cron Job):
#   competition-analytics-snapshots | GET /api/cron/competition-analytics-snapshots | 0 2 * * *
#   alumni-analytics-snapshots      | GET /api/cron/alumni-analytics-snapshots      | 0 3 * * *
#   Header on both: Authorization: Bearer ${CRON_SECRET}
# Blueprint alternative: render.yaml (rename web service name to match your Render Web Service).

# First manual run after deploy:
#   APP_URL=https://your-render-domain CRON_SECRET=... npm run cron:competition-snapshots
#   npm run verify:competition-snapshots

# Competition intelligence debug — local dev only; do NOT enable in Render production unless diagnosing.
# COMPETITION_INTEL_DEBUG=1
# NEXT_PUBLIC_COMPETITION_INTEL_DEBUG=1
